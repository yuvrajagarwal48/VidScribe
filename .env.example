# ==========================================
# VidScribe Environment Configuration
# ==========================================

# Google Gemini API Key (Required for Multimodal RAG & Synthesis)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider & Model Selection
LLM_PROVIDER=gemini
GEMINI_MODEL_NAME=gemini-2.5-flash

# Media Processing Parameters
# Higher threshold = fewer scenes detected (default: 20.0)
SCENE_THRESHOLD=20.0
MIN_SCENE_LEN=15
OCR_CONF_THRESHOLD=60

# Whisper Speech Recognition Model (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Vector Store & Retrieval
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K_RESULTS=8

# Server Networking (0.0.0.0 binds to all container/host interfaces)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
